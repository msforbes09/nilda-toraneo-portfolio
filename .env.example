# Copy to .env.local for local development. All values are public (they end up
# in the static bundle); never put a secret here.

# Third-party form endpoint (Formspree or equivalent). Empty = the contact form
# shows the email fallback and disables submit.
NEXT_PUBLIC_FORM_ENDPOINT=

# Canonical site URL, used for Open Graph metadata, sitemap.xml and robots.txt.
# Production (GitHub Pages): https://msforbes09.github.io/nilda-portfolio
NEXT_PUBLIC_SITE_URL=

# Path prefix when the site is served under a sub-path (GitHub Pages project
# site). The deploy workflow sets it to /nilda-portfolio; leave empty locally.
NEXT_PUBLIC_BASE_PATH=
